// Схема БД Nodus. Правила — docs/architecture/data-model.md:
// суррогатные UUID PK, created_at/updated_at везде, индексы с первой миграции,
// миграции задним числом не изменяются (только новые).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

/// Transactional outbox + event log (I9). Append-only; пишется только через
/// core EventBus в той же транзакции, что и изменение сущности.
model Event {
  id            String    @id @default(uuid()) @db.Uuid
  /// Имя из каталога событий (api-conventions.md), например `task.created`.
  type          String
  /// Глобальный монотонный порядок события (sequence БД); источник seq
  /// WS-envelope realtime-доставки (#104). Присваивается БД, не клиентом.
  seq           BigInt    @unique @default(autoincrement())
  actorId       String?   @map("actor_id") @db.Uuid
  aggregateType String?   @map("aggregate_type")
  aggregateId   String?   @map("aggregate_id") @db.Uuid
  /// Минимальный payload (id + ключевые поля).
  payload       Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  /// NULL = ожидает диспетчеризации поллером outbox.
  publishedAt   DateTime? @map("published_at") @db.Timestamptz()
  /// Метка realtime-фанута (#104): NULL = ещё не опубликовано в Redis Stream.
  /// Ставит RedisStreamPublisher ПОСЛЕ XADD; выборка `fanout_at IS NULL ORDER
  /// BY seq` не теряет поздно закоммиченное событие, как seq-курсор (аудит
  /// #123): курсор по seq перепрыгнул бы его навсегда. Парциальный индекс —
  /// в миграции (Prisma не выражает partial-индексы).
  fanoutAt      DateTime? @map("fanout_at") @db.Timestamptz()

  /// Историческая выборка по published_at; горячий путь поллера outbox
  /// (WHERE published_at IS NULL ORDER BY seq) — парциальный индекс
  /// `events_dispatch_pending_idx` в миграции (растёт только с хвостом).
  @@index([publishedAt, createdAt])
  @@index([aggregateType, aggregateId])
  @@map("events")
}

/// Дедупликация обработчиков событий (идемпотентность подписчиков, patterns.md).
model EventDelivery {
  eventId     String   @map("event_id") @db.Uuid
  /// Стабильный id обработчика (имя класса).
  handler     String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz()

  @@id([eventId, handler])
  @@map("event_deliveries")
}

/// Аудит действий пользователей (I7). Append-only; пишется AuditInterceptor.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  /// Действие в точечной нотации (`task.create`).
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  details    Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

/// Фичефлаги (I10): не-ядровые модули отключаемы без пересборки.
model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  /// Область применения (`global`; таргетинг по пользователям — позже).
  scope     String   @default("global")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("feature_flags")
}

// ===== Модуль directory + auth (issue #3, эпик M2 #18) =====

/// Статус учётной записи. Deactivated = архивация (уволен), вход запрещён,
/// исторические связи (задачи, события) сохраняются.
enum UserStatus {
  active
  deactivated
}

enum Gender {
  male
  female
}

/// Вид орг-единицы: management — управленческая структура (по ней живут БП
/// и задачи), legal — юридическая (трудовая книжка). Эпик M2: структуры
/// расходятся (BIM-отдел юридически в «Группе ГИПов»).
enum OrgUnitKind {
  management
  legal
}

/// Сотрудник (data-model.md: User). password_hash — Argon2id PHC-строка.
model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  lastName     String     @map("last_name")
  firstName    String     @map("first_name")
  middleName   String?    @map("middle_name")
  /// Отображаемое имя (денормализация ФИО; меняется вместе с ФИО).
  displayName  String     @map("display_name")
  status       UserStatus @default(active)
  avatarUrl    String?    @map("avatar_url")
  /// Аватар сотрудника (#186): файл модуля files — квадратный WebP-дериват;
  /// plain UUID без FK (I3). avatar_url (внешняя ссылка) не используется.
  avatarFileId String?    @map("avatar_file_id") @db.Uuid

  // Орг-связи (справочники по ID, I15)
  /// Прямой руководитель — гибкая связь внутри группы (ГИП ↔ помощник),
  /// без фиктивных отделов (эпик M2).
  managerId         String? @map("manager_id") @db.Uuid
  departmentId      String? @map("department_id") @db.Uuid
  positionId        String? @map("position_id") @db.Uuid
  legalDepartmentId String? @map("legal_department_id") @db.Uuid
  legalPositionId   String? @map("legal_position_id") @db.Uuid

  // Контактный блок карточки
  mobilePhone    String?   @map("mobile_phone")
  city           String?
  /// Кабинет / где находится.
  officeLocation String?   @map("office_location")
  isRemote       Boolean   @default(false) @map("is_remote")
  /// Рабочая ставка (1 = полная).
  workRate       Float?    @map("work_rate")
  gender         Gender?
  birthDate      DateTime? @map("birth_date") @db.Date
  /// Дата приёма на работу.
  hiredAt        DateTime? @map("hired_at") @db.Date
  /// Начало рабочего дня, «HH:mm».
  workdayStart   String?   @map("workday_start")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  manager         User?       @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates    User[]      @relation("UserManager")
  department      Department? @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  position        Position?   @relation("ManagementPosition", fields: [positionId], references: [id], onDelete: SetNull)
  legalDepartment Department? @relation("LegalDepartmentMembers", fields: [legalDepartmentId], references: [id], onDelete: SetNull)
  legalPosition   Position?   @relation("LegalPosition", fields: [legalPositionId], references: [id], onDelete: SetNull)

  roles               UserRole[]
  sessions            Session[]
  letterViews         LetterView[]
  headedDepartments   Department[] @relation("DepartmentHead")
  deputiedDepartments Department[] @relation("DepartmentDeputy")

  /// Список сотрудников: фильтр по статусу + детерминированная сортировка курсора.
  @@index([status, lastName, firstName, id])
  @@index([managerId])
  @@index([departmentId])
  /// FK SetNull-проверки при архивации справочников и фильтр юр. структуры.
  @@index([positionId])
  @@index([legalDepartmentId])
  @@index([legalPositionId])
  @@map("users")
}

/// Подразделение (data-model.md: Department). Дерево по parent_id;
/// руководитель (head) и постоянный заместитель (deputy) — эпик M2.
model Department {
  id        String      @id @default(uuid()) @db.Uuid
  name      String
  kind      OrgUnitKind @default(management)
  parentId  String?     @map("parent_id") @db.Uuid
  headId    String?     @map("head_id") @db.Uuid
  deputyId  String?     @map("deputy_id") @db.Uuid
  sortOrder Int         @default(0) @map("sort_order")
  /// Архивация вместо удаления (связи сотрудников и история сохраняются).
  isActive  Boolean     @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  parent   Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[] @relation("DepartmentTree")
  head     User?        @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  deputy   User?        @relation("DepartmentDeputy", fields: [deputyId], references: [id], onDelete: SetNull)

  members      User[] @relation("DepartmentMembers")
  legalMembers User[] @relation("LegalDepartmentMembers")

  /// Роли, привязанные к подразделению (#379, ADR-0034).
  roles DepartmentRole[]

  @@index([kind, parentId, sortOrder])
  /// FK SetNull-проверки (удаление подразделения/сотрудника) и подъём по дереву.
  @@index([parentId])
  @@index([headId])
  @@index([deputyId])
  @@map("departments")
}

/// Должность — плоский справочник; kind: management | legal (эпик M2).
model Position {
  id        String      @id @default(uuid()) @db.Uuid
  name      String
  kind      OrgUnitKind @default(management)
  sortOrder Int         @default(0) @map("sort_order")
  isActive  Boolean     @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  users      User[] @relation("ManagementPosition")
  legalUsers User[] @relation("LegalPosition")

  @@unique([name, kind])
  @@map("positions")
}

/// Роль RBAC — бизнес-данные (навык auth-route-guards): права собираются
/// администратором из каталога Permission и разворачиваются в JWT при логине.
model Role {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?
  /// Системная роль (seed): не удаляется, код не переименовывается.
  isSystem    Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  users       UserRole[]
  permissions RolePermission[]
  departments DepartmentRole[]

  @@map("roles")
}

/// Роль, привязанная к управленческому подразделению (#379, ADR-0034):
/// действует на сотрудников подразделения и всех вложенных. Юридическая
/// структура не участвует; архивная привязка прав не даёт.
model DepartmentRole {
  departmentId String   @map("department_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([departmentId, roleId])
  @@index([roleId])
  @@map("department_roles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Право роли — строка из каталога Permission контрактов.
model RolePermission {
  roleId     String @map("role_id") @db.Uuid
  permission String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permissions")
}

/// Сессия (data-model.md: Session): refresh-токен с ротацией и reuse-detection.
/// Храним хэши текущего и предыдущего refresh-токена: предъявление предыдущего
/// после ротации = компрометация → отзыв всей сессии (подход Auth0).
model Session {
  id                       String    @id @default(uuid()) @db.Uuid
  userId                   String    @map("user_id") @db.Uuid
  /// SHA-256 текущего refresh-токена (сам токен — только в httpOnly-cookie).
  refreshTokenHash         String    @map("refresh_token_hash")
  /// SHA-256 предыдущего токена (grace-окно ротации + reuse-detection).
  previousRefreshTokenHash String?   @map("previous_refresh_token_hash")
  userAgent                String?   @map("user_agent")
  ip                       String?
  expiresAt                DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt                DateTime? @map("revoked_at") @db.Timestamptz()

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("sessions")
}

// ===== Модуль chat (issue #58, эпик M6) =====

/// Беседа. type/visibility/роли — системные константы (TEXT, не pg enum, I15).
/// Привязки к сущностям других модулей (project/task/letter, author_id, user_*)
/// — plain UUID без FK: связь живёт на уровне приложения и событий (I3).
/// Пару direct-беседы охраняет частичный уникальный индекс
/// (user_min, user_max) WHERE type='direct' + CHECK user_min <= user_max
/// («диалог с собой» разрешён) — ДDL в миграции (Prisma не декларирует).
model Conversation {
  id            String    @id @default(uuid()) @db.Uuid
  /// direct | group | project_channel | task | letter.
  type          String
  title         String?
  description   String?
  /// closed | open (null у direct/task/letter).
  visibility    String?
  projectId     String?   @map("project_id") @db.Uuid
  taskId        String?   @map("task_id") @db.Uuid
  letterId      String?   @map("letter_id") @db.Uuid
  /// Матрица прав беседы: {changeInfo,addMembers,removeMembers,post,manageSettings}
  /// → минимальная роль (owner>admin>member); дефолты — contracts.
  permissions   Json
  /// Счётчик порядка сообщений: seq сообщений = last_seq после инкремента
  /// В ТОЙ ЖЕ транзакции отправки. Лок этой строки сериализует вставки беседы
  /// → порядок seq == порядок коммита (глобальный bigserial этого не даёт:
  /// значение выделяется до коммита, конкурентные транзакции коммитятся вне
  /// порядка seq — курсор «всё после N» навсегда пропускает поздние вставки
  /// с меньшим seq; postgres.org/docs/functions-sequence + Sequin).
  lastSeq       BigInt    @default(0) @map("last_seq")
  /// Момент последнего корневого сообщения — ось курсора списка бесед.
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz()
  /// Инициатор создания (для direct — кто нашёл/создал).
  createdBy     String    @map("created_by") @db.Uuid
  /// Нормализованная пара direct: min/max id участников (равны у «Заметок»).
  userMin       String?   @map("user_min") @db.Uuid
  userMax       String?   @map("user_max") @db.Uuid
  /// Аватар беседы (группа/канал, #186): файл модуля files — квадратный
  /// WebP-дериват; plain UUID без FK (I3). null — заглушка из инициалов.
  avatarFileId  String?   @map("avatar_file_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  members    ConversationMember[]
  messages   Message[]
  pins       ConversationPin[]
  drafts     ConversationDraft[]
  vaultStats ConversationVaultStats?

  @@index([lastMessageAt(sort: Desc), id])
  @@map("conversations")
}

/// Участие: роль, персональные настройки списка и якорь прочитанности.
/// last_read_seq — watermark (монотонный GREATEST, не откатывается): unread =
/// сообщения с seq > last_read_seq ИЛИ отредактированные после last_read_at.
model ConversationMember {
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  /// owner | admin | member.
  role           String
  lastReadSeq    BigInt    @default(0) @map("last_read_seq")
  /// Момент последнего продвижения курсора (для readAt и «правка → непрочитано»).
  lastReadAt     DateTime? @map("last_read_at") @db.Timestamptz()
  pinned         Boolean   @default(false)
  muted          Boolean   @default(false)
  /// «Посмотреть позже»: гасится своей отправкой/пересылкой (мок-семантика).
  snoozed        Boolean   @default(false)
  /// Архив беседы (история сохраняется). Раскрывается активностью (отправка/
  /// пересылка — revealHidden, #103) и открытием из поиска людей (PATCH).
  hidden         Boolean   @default(false)
  joinedAt       DateTime  @default(now()) @map("joined_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

/// Сообщение. seq уникален в беседе (порядок/курсор/якорь прочтения).
/// Идемпотентность в БД: unique(author_id, client_message_id); значение —
/// Idempotency-Key запроса (+суффикс «:i» у копий пересылки) — crash-окно
/// между Redis-реплеем и фиксацией закрывает БД (ADR-0005).
model Message {
  id                   String    @id @default(uuid()) @db.Uuid
  conversationId       String    @map("conversation_id") @db.Uuid
  seq                  BigInt
  authorId             String    @map("author_id") @db.Uuid
  clientMessageId      String    @map("client_message_id")
  text                 String    @default("")
  /// Вид сообщения (#380): text | task_transition (#313 добавит system).
  kind                 String    @default("text")
  /// Данные блока по виду сообщения (task_transition: TaskTransitionBlock).
  payload              Json?
  replyToId            String?   @map("reply_to_id") @db.Uuid
  /// Замороженный снапшот цитаты {authorId, text, quoteText, attachmentKind}:
  /// правка оригинала снапшот не меняет (вердикт 24.09); удалённость оригинала
  /// (deleted: true) вычисляется при чтении — «удаление сильнее заморозки».
  replySnapshot        Json?     @map("reply_snapshot")
  /// Тред ровно одного уровня: ссылка на корневое сообщение.
  threadRootId         String?   @map("thread_root_id") @db.Uuid
  /// Атрибуция пересылки (источник может быть удалён — переход решает сервис).
  fwdConversationId    String?   @map("fwd_conversation_id") @db.Uuid
  fwdMessageId         String?   @map("fwd_message_id") @db.Uuid
  fwdAuthorId          String?   @map("fwd_author_id") @db.Uuid
  fwdThreadRootId      String?   @map("fwd_thread_root_id") @db.Uuid
  editedAt             DateTime? @map("edited_at") @db.Timestamptz()
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz()
  /// Бесследное удаление (нет живых ответов, #163): строка остаётся ради
  /// непрерывности seq, ссылок тредов/цитат/пинов и аудита, но исключается
  /// из всех выдач. false у надгробия (видно как «Сообщение удалено»).
  obliterated          Boolean   @default(false)
  /// «Важное сообщение» (#100, ревизия модели 05.10): пробивается через
  /// mute/DND верхним ярусом; непрочитавшим повторяем пуш каждые 5 минут
  /// до часа (аналитика прочтений — watermark/readBy); действий получателя
  /// не требует (ack-механика выпилена решением владельца 05.10).
  urgent               Boolean   @default(false)
  /// userId упомянутых @Имя — снапшот текущей версии (#100, канон
  /// Discord/Zulip; правка пересчитывает, #176).
  mentionedUserIds     Json?     @map("mentioned_user_ids")
  /// Накопительное множество упомянутых за ВСЮ историю сообщения (#239):
  /// дифф-уведомления правок пингуют только при ПЕРВОМ упоминании человека
  /// (вердикт владельца: «убрали-вернули того же — не дёргается»).
  everMentionedUserIds Json?     @map("ever_mentioned_user_ids")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  conversation       Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo            Message?            @relation("MessageReply", fields: [replyToId], references: [id], onDelete: Restrict)
  replies            Message[]           @relation("MessageReply")
  threadRoot         Message?            @relation("ThreadTree", fields: [threadRootId], references: [id], onDelete: Restrict)
  threadReplies      Message[]           @relation("ThreadTree")
  threadParticipants ThreadParticipant[] @relation("ThreadParticipants")
  reactions          MessageReaction[]
  messagePins        ConversationPin[]
  attachments        MessageAttachment[]
  favorites          Favorite[]
  links              MessageLink[]

  @@unique([conversationId, seq])
  @@unique([authorId, clientMessageId])
  @@index([conversationId, seq(sort: Desc)])
  @@index([authorId, createdAt])
  @@index([threadRootId])
  @@index([replyToId])
  @@map("messages")
}

/// Реакция (toggle, контракт messageReactionToggleBodySchema): PK исключает
/// дубль своей реакции тем же эмодзи.
model MessageReaction {
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  emoji     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
  @@map("message_reactions")
}

/// Закреп: одно на сообщение (лента закрепов — GET /pins, свежие первыми).
model ConversationPin {
  conversationId String   @map("conversation_id") @db.Uuid
  messageId      String   @unique @map("message_id") @db.Uuid
  pinnedBy       String   @map("pinned_by") @db.Uuid
  pinnedAt       DateTime @default(now()) @map("pinned_at") @db.Timestamptz()

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([conversationId, pinnedAt(sort: Desc)])
  @@map("conversation_pins")
}

/// Черновик: отдельная таблица (не поле участника) — горячая строка
/// last_read_* не пухнет от TOAST-текста. revision монотонно растит сервер
/// (last-write-wins между устройствами); пустой текст = удаление (мок-модель).
model ConversationDraft {
  conversationId String   @map("conversation_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  text           String
  revision       Int      @default(0)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("conversation_drafts")
}

/// Участник треда (уведомления треда — только участникам, core-flows поток Д):
/// автор корня | ответивший | наблюдатель. Заполняется с первого ответа;
/// потребитель — трек уведомлений (после M13).
model ThreadParticipant {
  threadRootId String   @map("thread_root_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  /// author | replier | watcher | mentioned (@-упоминание — тоже наблюдатель,
  /// раунд 3).
  source       String
  /// Watermark трэда (точка «есть новые» на посте, раунд 3): чужие ответы
  /// с seq > lastReadSeq — непрочитанные; двигается квитанцией из треда
  /// (POST /read c threadRootId), GREATEST — не откатывается.
  lastReadSeq  BigInt   @default(0) @map("last_read_seq")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  threadRoot Message @relation("ThreadParticipants", fields: [threadRootId], references: [id], onDelete: Cascade)

  @@id([threadRootId, userId])
  @@index([userId])
  @@map("thread_participants")
}

/// Вложение сообщения (Ф6 — после #57: файлы/MinIO). Загруженное-но-не-
/// отправленное живёт с message_id IS NULL у владельца; привязка при отправке
/// ОДНОРАЗОВАЯ (мок-модель). file_id → сущность модуля files, plain UUID (I3).
model MessageAttachment {
  id          String   @id @default(uuid()) @db.Uuid
  messageId   String?  @map("message_id") @db.Uuid
  fileId      String   @map("file_id") @db.Uuid
  /// Кто загрузил (валидация одноразовой привязки).
  ownerId     String   @map("owner_id") @db.Uuid
  name        String
  size        Int
  mime        String
  /// image | file | sticker — явный вид (НЕ выводится из mime; контракт).
  kind        String
  width       Int?
  height      Int?
  /// FileObject серверного превью (WebP-дериват, #150); null — не сгенерировано
  /// (воркер ещё не дошёл / формат не декодируется). Пересылка копирует ссылку.
  thumbFileId String?  @map("thumb_file_id") @db.Uuid
  /// Снапшот метаданных стикера (kind='sticker', #143): {packId, packTitle,
  /// packScope, emojis} — заморожен на момент отправки, как reply-цитаты;
  /// удаление пака рендер отправленных сообщений не ломает.
  stickerMeta Json?    @map("sticker_meta")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  message Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([ownerId])
  /// Гейт доступа к файлу (`WHERE file_id = ?` на каждую отдачу вложения).
  @@index([fileId])
  @@map("message_attachments")
}

// ===================== избранное чата (#171, M6) =====================

/// Проекция ссылок сообщения (#211): URL из текста, извлекаемые ПРИ
/// ОТПРАВКЕ/ПРАВКЕ в той же транзакции (write-time projection, модель
/// Telegram/Bitrix — счётчики и списки секции «Ссылки» без скана текстов;
/// переиспользуется превью ссылок #212). Удаление/бесследие сообщения
/// чистит строки физически (восстановления нет, #163).
model MessageLink {
  id             String   @id @default(uuid()) @db.Uuid
  messageId      String   @map("message_id") @db.Uuid
  /// Денормализация для keyset-списка витрины без join на навигацию.
  conversationId String   @map("conversation_id") @db.Uuid
  /// Денормализация треда (скоуп «Этот тред», null у корней ленты).
  threadRootId   String?  @map("thread_root_id") @db.Uuid
  /// Порядок в тексте сообщения (устойчивый ключ страницы внутри seq).
  position       Int
  url            String
  /// Автор сообщения — контекст строки витрины (кто отправил).
  authorId       String   @map("author_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, position])
  @@index([conversationId, threadRootId, position])
  @@index([authorId])
  @@map("message_links")
}

/// Кэш превью ссылок (#212, ADR-0018): асинхронный конвейер BullMQ —
/// сообщение летит мгновенно, карточка дозревает фоном (WS-событие).
/// Ключ — нормализованный URL (url-normalize.ts, общий для ключа и
/// обогащения); TTL готовых 24ч, отрицательный (failed) 1ч, blocked —
/// навсегда. expand-only: обратной миграции данных нет.
model LinkPreview {
  id            String    @id @default(uuid()) @db.Uuid
  normalizedUrl String    @unique @map("normalized_url")
  /// pending | ready | failed | blocked (blocked = SSRF/отказ гварда).
  status        String
  title         String?
  description   String?
  siteName      String?   @map("site_name")
  /// og:image-дериват в SILO (≤640px webp, #139); null — без картинки.
  imageFileId   String?   @map("image_file_id") @db.Uuid
  faviconFileId String?   @map("favicon_file_id") @db.Uuid
  fetchedAt     DateTime? @map("fetched_at") @db.Timestamptz()
  /// Годен до: ready 24ч, failed 1ч, blocked бессрочно (null).
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz()
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([status, expiresAt])
  @@map("link_previews")
}

/// Денормализованные счётчики витрины беседы (#211): image (kind='image'),
/// video/audio (файлы с mime video/*|audio/*), document (остальные файлы),
/// link (строки message_links) — только ЖИВЫЕ сообщения (надгробие/
/// бесследие уменьшает). Обслуживание — Δ в тех же транзакциях состава
/// (send/edit/delete/batch-delete/forward), модель Telegram getSearchCounters /
/// Битрикс24 (чтение O(1), «не для пилотных объёмов»); backfill-миграции
/// обеспечивают стартовую консистентность, инвариант stats == COUNT(живых)
/// проверяется integration-тестами.
model ConversationVaultStats {
  conversationId String @id @map("conversation_id") @db.Uuid
  imageCount     Int    @default(0) @map("image_count")
  videoCount     Int    @default(0) @map("video_count")
  audioCount     Int    @default(0) @map("audio_count")
  documentCount  Int    @default(0) @map("document_count")
  linkCount      Int    @default(0) @map("link_count")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("conversation_vault_stats")
}

/// Личная закладка-ссылка на сообщение (#171, «закладка, не копия»):
/// контент живёт в оригинале — правки отражаются, удаление оригинала гасит
/// карточку в надгробие (#163), строки оригинала не удаляются физически.
/// PK (user_id, message_id) = идемпотентность звезды. Метки — ЛИЧНЫЕ
/// эмодзи-реакции (JSONB ["🔑"] ≤ 20, модель Telegram Premium, ревизия
/// 04.10; НЕ справочник: I15 про бизнес-списки).
model Favorite {
  userId    String   @map("user_id") @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  /// Историческая колонка (контракт note не отдаёт с ревизии 04.10;
  /// удаление — contract-этап по канону prisma-migrations).
  note      String   @default("")
  /// ["🔑"] ≤ 20 — личные эмодзи-метки (чипы поиска витрины «Избранного»).
  labels    Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([userId, messageId])
  @@index([userId, createdAt(sort: Desc)])
  /// Чистка закладок при удалении сообщения (`WHERE message_id = ?`) + каскад FK.
  @@index([messageId])
  @@map("favorites")
}

// ===================== стикеры чата (#143, M6) =====================

/// Пак стикеров: корпоративный (право sticker.manage, ownerId null) или
/// личный (каждый сотрудник себе). Дистрибуция личных — только «из чата»
/// (получатель ставит пак себе); каталога с поиском нет осознанно.
/// Удаление — soft: пак исчезает из пикеров у всех, отправленные сообщения
/// рендерятся дальше по снапшоту message_attachments.sticker_meta.
model StickerPack {
  id        String    @id @default(uuid()) @db.Uuid
  title     String
  /// corporate | personal — системная константа (zod в contracts), не бизнес-справочник.
  scope     String
  /// Владелец личного пака; null для корпоративного.
  ownerId   String?   @map("owner_id") @db.Uuid
  /// Создатель (у корпоративного — админ с правом sticker.manage).
  createdBy String    @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  stickers         Sticker[]
  installedByUsers UserStickerPack[]

  @@index([ownerId])
  @@map("sticker_packs")
}

/// Стикер пака: файл в модуле files (file_id plain UUID, I3 — паттерн
/// MessageAttachment), эмодзи-привязки 1–3 (поиск/подсказки «эмодзи →
/// стикеры», фаза 2). Формат: WebP/PNG ≤512КБ, WebM/VP9 без звука ≤256КБ
/// (валидация magic bytes на сервере).
model Sticker {
  id        String   @id @default(uuid()) @db.Uuid
  packId    String   @map("pack_id") @db.Uuid
  fileId    String   @map("file_id") @db.Uuid
  emojis    String[]
  width     Int?
  height    Int?
  mime      String
  size      Int
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  pack StickerPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@index([packId])
  @@map("stickers")
}

/// Пак, установленный пользователю («добавил из чата»). PK (userId, packId)
/// даёт идемпотентность установки. Корпоративные видны всем без установки.
model UserStickerPack {
  userId  String   @map("user_id") @db.Uuid
  packId  String   @map("pack_id") @db.Uuid
  addedAt DateTime @default(now()) @map("added_at") @db.Timestamptz()

  pack StickerPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@id([userId, packId])
  @@index([packId])
  @@map("user_sticker_packs")
}

// ===================== files (#57, M9 фаза 1) =====================

/// Файл в объектном хранилище (MinIO, ADR-0013): логическая сущность;
/// физические версии — FileVersion (фаза 1 создаёт ровно одну, v1).
/// Право на файл решает модуль-потребитель (chat: message_attachments
/// plain file_id, I3 — без FK между модулями).
model FileObject {
  id          String    @id @default(uuid()) @db.Uuid
  ownerId     String    @map("owner_id") @db.Uuid
  bucket      String
  /// Ключ ТЕКУЩЕЙ версии в бакете (указатель; история — в FileVersion).
  key         String    @unique
  /// Номер текущей версии (указатель на FileObject.versions[N]; растёт при
  /// сохранениях ONLYOFFICE, #138). Миграция 28.09: существующие файлы = v1.
  version     Int       @default(1)
  name        String
  mime        String
  size        Int
  /// pending | clean | infected — гейт отдачи (ADR-0013): infected не
  /// отдаётся никогда (410); pending отдаётся, пока сканера нет (ClamAV —
  /// фаза 2, M14). Карантин — префикс ключа quarantine/, фаза 2.
  scanStatus  String    @default("pending") @map("scan_status")
  /// Дериват: FileObject порождён из файла derivedFrom (превью вложений
  /// #150). null — «пользовательский» файл; дериваты исключаются из
  /// выборок «файлов пользователя» и живут вместе с оригиналом (plain UUID,
  /// между модулями без FK, I3).
  derivedFrom String?   @map("derived_from") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  versions    FileVersion[]
  derivatives FileDerivative[]

  @@index([ownerId])
  @@map("file_objects")
}

/// Производная версия файла из конвейера #139: PDF-копия офисного документа
/// (fallback-просмотр при лежащем движке) и PNG-иконка первой страницы
/// (карточка вложения). Ключ генерации = (fileObject, version): правки
/// ONLYOFFICE создают новую версию → конвейер перегенерирует. Миниатюры
/// изображений — отдельный конвейер чата (#150, WebP), здесь не дублируются.
model FileDerivative {
  id           String   @id @default(uuid()) @db.Uuid
  fileObjectId String   @map("file_object_id") @db.Uuid
  version      Int
  /// pdf | icon (спека #139; thumbnail живёт в конвейере #150).
  kind         String
  /// pending | ready | failed (ретраи очереди — attempts).
  status       String   @default("pending")
  /// Ключ объекта в хранилище (SILO); null, пока не ready.
  key          String?
  size         Int      @default(0)
  mime         String
  error        String?
  attempts     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  fileObject FileObject @relation(fields: [fileObjectId], references: [id], onDelete: Cascade)

  @@unique([fileObjectId, version, kind])
  @@index([fileObjectId])
  @@map("file_derivatives")
}

/// Физическая версия файла в хранилище: фаза 1 — одна (v1) на каждый upload;
/// таблица с первого дня — версии (перегрузки писем и пр.) не потребуют
/// миграций и смены контрактов.
model FileVersion {
  id             String   @id @default(uuid()) @db.Uuid
  fileObjectId   String   @map("file_object_id") @db.Uuid
  /// 1.. — монотонно; уникально в пределах файла.
  version        Int
  key            String
  size           Int
  mime           String
  /// Ключ документа ONLYOFFICE, из которого сохранена версия (#138):
  /// `${fileId}.v{N}` на момент правки — дедуп повторных колбэков
  /// (алфавит ключа DS без двоеточия — см. office-session.service).
  sourceKey      String?  @map("source_key")
  /// lastsave колбэка (мс epoch): повторная доставка того же сохранения
  /// (forcesave → закрытие) не создаёт дубликат-версию.
  sourceLastsave BigInt?  @map("source_lastsave")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  fileObject FileObject @relation(fields: [fileObjectId], references: [id], onDelete: Cascade)

  @@unique([fileObjectId, version])
  @@map("file_versions")
}

// ===== Модуль notifications (#100, ADR-0016) =====

/// Приоритет уведомления (ADR-0017): абстрактная шкала важности urgent |
/// high | medium | low, маппинг kind → priority — таблица на бэке.
/// Системная константа (не бизнес-справочник, I15): enum допустим в БД? — нет:
/// TEXT + zod-контракт (канон prisma-migrations: бизнес-значения без ENUM).

/// Журнал уведомлений — источник истины (ADR-0016): каждое уведомление
/// персистентно; WS только будит. seq — bigserial (курсор дельты после
/// reconnect); (event_id, user_id) — дедуп повторной доставки события (D4).
model Notification {
  id                String    @id @default(uuid()) @db.Uuid
  /// Глобальный порядок журнала: курсор дельты `?afterSeq=` (D1/D3).
  seq               BigInt    @unique @default(autoincrement())
  userId            String    @map("user_id") @db.Uuid
  /// urgent | high | medium | low (zod-контракт, ADR-0017).
  priority          String
  /// Механика источника (urgent.message, chat.mention, action.assignment…).
  kind              String
  /// conversation | message | task | letter | workflow.
  sourceType        String    @map("source_type")
  /// Id агрегата источника (переход по клику, группировка строк).
  sourceId          String    @map("source_id") @db.Uuid
  /// seq события-источника в беседе (гашение по watermark прочтения).
  sourceSeq         BigInt    @map("source_seq")
  actorId           String?   @map("actor_id") @db.Uuid
  /// Превью текста (поиск, строка ленты).
  preview           String?
  /// Полный текст важного — тело строки журнала/пуша (только urgent).
  urgentText        String?   @map("urgent_text")
  conversationId    String?   @map("conversation_id") @db.Uuid
  conversationTitle String?   @map("conversation_title")
  messageId         String?   @map("message_id") @db.Uuid
  threadRootId      String?   @map("thread_root_id") @db.Uuid
  /// Событие-первоисточник: дедуп (event_id, user_id) = один экземпляр.
  eventId           String    @map("event_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  readAt            DateTime? @map("read_at") @db.Timestamptz()
  /// Ознакомление (СЭД-паттерн): только urgent; отдельный от readAt акт.
  ackAt             DateTime? @map("ack_at") @db.Timestamptz()
  /// Повторы срочного остановлены (прочтение/ответ/реакция/потолок, C2/C3).
  repeatsStoppedAt  DateTime? @map("repeats_stopped_at") @db.Timestamptz()

  deliveries NotificationDelivery[]

  @@unique([eventId, userId])
  @@index([userId, readAt, seq(sort: Desc)])
  @@index([userId, seq(sort: Desc)])
  @@index([sourceId, priority, ackAt])
  @@index([priority, readAt, createdAt])
  /// Чистка журнала по удалённому сообщению (#267: DELETE WHERE message_id).
  @@index([messageId])
  @@map("notifications")
}

/// Журнал доставок по каналам (C11/D6): когда и каким каналом доставлено;
/// повторы срочного — строки channel='repeat' с номером попытки.
model NotificationDelivery {
  id             String   @id @default(uuid()) @db.Uuid
  notificationId String   @map("notification_id") @db.Uuid
  /// ws | repeat (расширяемо: будущие desktop/push-каналы).
  channel        String
  /// 0 — первая доставка; 1..N — попытки повтора.
  attempt        Int      @default(0)
  deliveredAt    DateTime @default(now()) @map("delivered_at") @db.Timestamptz()

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId, deliveredAt])
  @@map("notification_deliveries")
}

/// Настройки уведомлений пользователя (DND-расписание; ADR-0016 §3).
model NotificationSetting {
  userId     String  @id @map("user_id") @db.Uuid
  dndEnabled Boolean @default(false) @map("dnd_enabled")
  /// Окно «не беспокоить», локальное «HH:mm» (подавление на клиенте).
  dndStart   String  @default("22:00") @map("dnd_start")
  dndEnd     String  @default("08:00") @map("dnd_end")

  @@map("notification_settings")
}

// ===== Модуль tasks (issue #37, эпик M4 #49; ADR-0008, ADR-0020) =====
// Системные константы (kind, systemState, role, method, source, priority,
// color) — TEXT с проверкой zod-контрактами (I15: бизнес-списки — данные).
// Пользователи и проекты — plain UUID без FK (I3). Порядковые ключи
// (stage_order, sort_order) — fractional-index TEXT COLLATE "C" (байтовый
// порядок; коллация задаётся в миграции — Prisma её не декларирует).

/// Тип процесса — глобальный справочник (ADR-0020, ADR-0024): задача или
/// письмо. code — стабильный ключ системного каталога (бутстрап модуля
/// создаёт недостающее, не перезаписывает).
model ProcessType {
  id              String    @id @default(uuid()) @db.Uuid
  code            String    @unique
  name            String
  /// Категория сущности (ADR-0024): task | letter. Неизменяема после
  /// создания — от неё зависят карточка, реестры и адаптер движка.
  category        String    @default("task")
  /// Направление письма: incoming | outgoing; null у задач (CHECK в
  /// миграции: (category = 'letter') = (direction IS NOT NULL)).
  direction       String?
  /// УСТАРЕЛО (#428): узлы дерева проекта — сущность модуля проектов
  /// (ADR-0030), флаг не читается; колонка снимается contract-chore #439.
  structural      Boolean   @default(false)
  isSystem        Boolean   @default(false) @map("is_system")
  /// Значок-ключ закрытого реестра contracts (processTypeIconSchema, #378).
  icon            String    @default("square-check")
  /// Тон плитки-значка (stageColorSchema).
  color           String    @default("neutral")
  description     String    @default("")
  /// Доступен в экспресс-форме создания задач (#378).
  creatable       Boolean   @default(true)
  /// Правился руками (редактор): каталог «засев один раз» не трогает (#378).
  customizedAt    DateTime? @map("customized_at") @db.Timestamptz()
  /// Ревизия каталога, последняя применённая к типу (ADR-0021).
  catalogRevision Int       @default(0) @map("catalog_revision")
  sortOrder       Int       @default(0) @map("sort_order")
  /// Конфигурация типа (#432, ADR-0024 п.5): состав карточки (`card`) и
  /// доступ (`access`). Сохраняется сразу, публикации не требует; схема
  /// `processTypeConfigSchema`, битый раздел читается как умолчание.
  config          Json      @default("{}")
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz()
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  schemeEntries WorkflowSchemeEntry[]
  fieldBindings FieldDefinitionType[]

  @@map("process_types")
}

/// Маршрут: стадии + переходы. kind: task (маршрут типа задачи) | personal
/// (личный «Мой план», ownerId; шаблон — isTemplate без владельца).
/// Один личный маршрут на сотрудника — частичный unique в миграции.
model Workflow {
  id              String    @id @default(uuid()) @db.Uuid
  /// Ключ системного каталога (null у личных экземпляров).
  code            String?   @unique
  name            String
  kind            String
  ownerId         String?   @map("owner_id") @db.Uuid
  isSystem        Boolean   @default(false) @map("is_system")
  isTemplate      Boolean   @default(false) @map("is_template")
  /// Версия публикации (#378, ADR-0021): optimistic concurrency — публикация
  /// сверяет baseVersion, конфликт → 409.
  version         Int       @default(1)
  publishedAt     DateTime? @map("published_at") @db.Timestamptz()
  publishedById   String?   @map("published_by_id") @db.Uuid
  /// Правился руками (редактор): каталог «засев один раз» не трогает (#378).
  customizedAt    DateTime? @map("customized_at") @db.Timestamptz()
  /// Ревизия каталога, последняя применённая к маршруту (ADR-0021).
  catalogRevision Int       @default(0) @map("catalog_revision")
  /// Раскладка холста редактора — общая для всех (#378 ред. 2, ADR-0022):
  /// позиции статусов, точки подключения и положение подписей кнопок
  /// (схема `workflowLayoutSchema`). Пусто — авторасстановка.
  layout          Json      @default("{}")
  /// Форма создания — окно узла «Создание» (#432): слоты и чипы. null —
  /// форма по умолчанию (нынешняя экспресс-форма). Публикуется версией.
  creation        Json?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  stages        WorkflowStage[]
  transitions   WorkflowTransition[]
  schemeEntries WorkflowSchemeEntry[]

  @@index([kind, ownerId])
  @@map("workflows")
}

/// Стадия маршрута = колонка канбана. Удаление = архивация (I15): задачи и
/// история ссылаются на стадию навсегда.
model WorkflowStage {
  id          String    @id @default(uuid()) @db.Uuid
  workflowId  String    @map("workflow_id") @db.Uuid
  /// Ключ стадии системного каталога (null у пользовательских).
  code        String?
  name        String
  /// Тон палитры темы (stageColorSchema).
  color       String
  sortOrder   Int       @map("sort_order")
  /// backlog | active | paused | done | closed (скрытая ось, ADR-0008);
  /// фазы open / review (done = «Утверждение») / final — ADR-0020 доп. 2.
  systemState String    @map("system_state")
  /// Итог закрытой стадии (#378, #430): success | cancelled | rejected;
  /// только у этапа «Итог» (CHECK в миграции: (system_state = 'closed') = (outcome NOT NULL)).
  outcome     String?
  /// Начальная стадия маршрута (новые задачи без колонки).
  isInitial   Boolean   @default(false) @map("is_initial")
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  workflow        Workflow                @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  transitionsFrom WorkflowTransition[]    @relation("TransitionFrom")
  transitionsTo   WorkflowTransition[]    @relation("TransitionTo")
  placements      TaskPersonalPlacement[]

  @@unique([workflowId, code])
  @@index([workflowId, sortOrder])
  @@map("workflow_stages")
}

/// Переход маршрута (кнопка). fromStageId null — «из любой стадии».
/// rules — {conditions, validators, postFunctions} закрытого реестра
/// contracts (workflowTransitionRulesSchema); неизвестный вид сервер отвергает.
model WorkflowTransition {
  id          String    @id @default(uuid()) @db.Uuid
  workflowId  String    @map("workflow_id") @db.Uuid
  code        String?
  name        String
  fromStageId String?   @map("from_stage_id") @db.Uuid
  toStageId   String    @map("to_stage_id") @db.Uuid
  /// Показ кнопки (#378): primary | button | menu.
  display     String    @default("button")
  /// Смысл кнопки (#430): action | service; служебные не попадают в «Мои действия».
  intent      String    @default("action")
  /// Удаление в редакторе = архивация: история и события ссылаются (#378).
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz()
  sortOrder   Int       @default(0) @map("sort_order")
  rules       Json      @default("{}")
  /// Окно при нажатии (#380): часть документа маршрута, публикуется с ним.
  form        Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  workflow  Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  fromStage WorkflowStage? @relation("TransitionFrom", fields: [fromStageId], references: [id], onDelete: Restrict)
  toStage   WorkflowStage  @relation("TransitionTo", fields: [toStageId], references: [id], onDelete: Restrict)

  @@unique([workflowId, code])
  @@index([workflowId, fromStageId])
  @@index([toStageId])
  @@map("workflow_transitions")
}

/// Схема маршрутов: тип → маршрут. isDefault — системная схема задач без
/// проекта (одна); проект выбирает свою (ступень 3).
model WorkflowScheme {
  id        String   @id @default(uuid()) @db.Uuid
  code      String?  @unique
  name      String
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  entries WorkflowSchemeEntry[]

  @@map("workflow_schemes")
}

model WorkflowSchemeEntry {
  schemeId      String @map("scheme_id") @db.Uuid
  processTypeId String @map("process_type_id") @db.Uuid
  workflowId    String @map("workflow_id") @db.Uuid

  scheme      WorkflowScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  processType ProcessType    @relation(fields: [processTypeId], references: [id], onDelete: Restrict)
  workflow    Workflow       @relation(fields: [workflowId], references: [id], onDelete: Restrict)

  @@id([schemeId, processTypeId])
  @@index([processTypeId])
  @@index([workflowId])
  @@map("workflow_scheme_entries")
}

/// Серия номеров «Процессов» (#55, ADR-0027 доп. O1): префикс и правило
/// сброса. Регистрационный номер письма выдаёт движок в транзакции перехода
/// (`assign_number`), поэтому серии живут в модуле процессов, а не в письмах.
/// Серии `letter-incoming` «Вх» и `letter-outgoing` «Исх» засевает каталог.
model NumberSeries {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  /// Префикс номера: «Вх» → «Вх-2026/118».
  prefix    String
  /// Правило сброса счётчика: year (единственное в #55; CHECK в миграции).
  reset     String   @default("year")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  counters NumberCounter[]

  @@map("number_series")
}

/// Счётчик серии на год. Строка сериализует регистрации серии (upsert с
/// `last_value + 1`): откат транзакции не сдвигает счётчик → номеров без
/// пропусков. Год — по часовому поясу компании (`COMPANY_TIMEZONE`).
model NumberCounter {
  seriesId  String @map("series_id") @db.Uuid
  year      Int
  lastValue Int    @default(0) @map("last_value")

  series NumberSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([seriesId, year])
  @@map("number_counters")
}

/// Задача. Проект необязателен (projectId nullable, без FK — I3): задача без
/// проекта — обычный случай. number — глобальный счётчик (sequence; дыры
/// при откате допустимы), «ПП-N» — слой отображения. Удаление — мягкое.
/// type_id / workflow_id / stage_id — plain UUID без FK (ADR-0024): типы,
/// маршруты и стадии принадлежат модулю «Процессы» (I3); целостность держится
/// тем, что они архивируются, а не удаляются.
model Task {
  id                String    @id @default(uuid()) @db.Uuid
  number            Int       @unique @default(autoincrement())
  title             String
  description       String    @default("")
  typeId            String    @map("type_id") @db.Uuid
  workflowId        String    @map("workflow_id") @db.Uuid
  stageId           String    @map("stage_id") @db.Uuid
  /// Денормализация stage.systemState в той же tx (фильтры/счётчики, I14).
  systemState       String    @map("system_state")
  stateChangedAt    DateTime  @default(now()) @map("state_changed_at") @db.Timestamptz()
  /// Порядок в колонке глобальной оси (fractional-index, COLLATE "C").
  stageOrder        String    @map("stage_order")
  priority          String    @default("normal")
  deadline          DateTime? @db.Timestamptz()
  plannedMinutes    Int?      @map("planned_minutes")
  acceptRequired    Boolean   @default(false) @map("accept_required")
  creatorId         String    @map("creator_id") @db.Uuid
  assigneeId        String    @map("assignee_id") @db.Uuid
  parentId          String?   @map("parent_id") @db.Uuid
  projectId         String?   @map("project_id") @db.Uuid
  /// Узел структуры проекта (#467, ADR-0030 «Дополнение»): дерево — сущность
  /// модуля проектов, поэтому plain UUID без FK (канон projectId, I3);
  /// задача — лист дерева. null — вне структуры («Без узла»).
  nodeId            String?   @map("node_id") @db.Uuid
  /// manual | chat_message | letter; sourceId — id сообщения/поручения
  /// (дедуп: частичный unique (source, source_id, creator_id) по живым
  /// задачам — в миграции).
  source            String    @default("manual")
  sourceId          String?   @map("source_id") @db.Uuid
  /// Снимок цепочки происхождения (TaskChainNode[] без узла самой задачи).
  origin            Json?
  spentMinutes      Int       @default(0) @map("spent_minutes")
  checklistDone     Int       @default(0) @map("checklist_done")
  checklistTotal    Int       @default(0) @map("checklist_total")
  /// Сообщений в чате задачи (денорм подпиской на chat.message_sent, #252).
  commentsCount     Int       @default(0) @map("comments_count")
  /// Кастомные поля (FieldDefinition, data-model.md); GIN — в миграции.
  customFields      Json      @default("{}") @map("custom_fields")
  /// «Конфиденциально» (#461, Р5): задача видна ТОЛЬКО участникам (создатель,
  /// ответственный, соисполнители, наблюдатели) — без руководителей по
  /// оргструктуре, видимых проектов и `task.view_all`; список/карточка/ветка/
  /// поиск/счётчики наследуют правило через `visibleTasksWhere`. Пишется
  /// поручениями из конфиденциального письма (#463); интерфейс-переключатель
  /// у задач — там же.
  confidential      Boolean   @default(false)
  /// Ключ внешней системы (импорт из Битрикса: «b24:12345»).
  externalRef       String?   @unique @map("external_ref")
  /// Момент входа в «Итог» (closed: выполнена/отменена); снимается выходом.
  /// «Утверждение» (done) — не завершение (ADR-0020, дополнение 2).
  completedAt       DateTime? @map("completed_at") @db.Timestamptz()
  /// Однократное уведомление о просрочке; сбрасывается сменой срока.
  overdueNotifiedAt DateTime? @map("overdue_notified_at") @db.Timestamptz()
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz()
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  parent   Task?  @relation("TaskTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Task[] @relation("TaskTree")

  participants  TaskParticipant[]
  placements    TaskPersonalPlacement[]
  checklist     TaskChecklistItem[]
  relationsFrom TaskRelation[]          @relation("RelationFrom")
  relationsTo   TaskRelation[]          @relation("RelationTo")
  timeEntries   TimeEntry[]
  results       TaskResult[]

  @@index([source, sourceId])
  @@index([stageId, stageOrder, id])
  @@index([assigneeId, systemState])
  @@index([creatorId, systemState])
  @@index([parentId])
  @@index([projectId])
  /// Срез задач узла дерева (#467): rollup-агрегаты и перенос задач.
  @@index([nodeId])
  /// Фильтр по типу и маршруту (FK между модулями нет — ADR-0024).
  @@index([typeId])
  @@index([workflowId])
  @@index([systemState, deadline])
  @@index([updatedAt(sort: Desc), id])
  @@index([customFields(ops: JsonbPathOps)], type: Gin, map: "tasks_custom_fields_gin")
  @@map("tasks")
}

/// Соисполнитель / наблюдатель. Ответственный и постановщик — колонки Task.
model TaskParticipant {
  taskId    String   @map("task_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// coexecutor | observer.
  role      String
  /// Новый наблюдатель — без звука (Битрикс24); уведомления только явные.
  muted     Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId, role])
  @@map("task_participants")
}

/// Общий журнал переходов «Процессов» (ADR-0024 п.4): пишет движок (#380).
/// Сущность — (entity_kind, entity_id) plain UUID: задачи и письма живут в
/// своих модулях. Переход null — запись сбора отметок. Создана пустой в #428.
model TransitionRecord {
  id            String   @id @default(uuid()) @db.Uuid
  /// task | letter — категория сущности (словарь ProcessType.category).
  entityKind    String   @map("entity_kind")
  entityId      String   @map("entity_id") @db.Uuid
  /// Переход маршрута; null — отметка сбора/возврат/снятие.
  transitionId  String?  @map("transition_id") @db.Uuid
  fromStageId   String   @map("from_stage_id") @db.Uuid
  toStageId     String   @map("to_stage_id") @db.Uuid
  /// Актёр (сотрудник) или null, когда запись породило правило/система.
  actorId       String?  @map("actor_id") @db.Uuid
  /// Правило, породившее запись (postFunction/validator), если актёра нет.
  rule          String?
  /// transition | press | return | withdraw | exclude (ADR-0024/0025).
  recordKind    String   @map("record_kind")
  /// Участник сбора отметок (press/return/withdraw/exclude).
  participantId String?  @map("participant_id") @db.Uuid
  comment       String?
  /// Итог перехода — id ревизии итога сущности (TaskResult у задач), а не исход.
  resultId      String?  @map("result_id") @db.Uuid
  /// Изменённые поля (закрытый словарь категории), JSONB.
  fields        Json     @default("{}")
  timeEntryId   String?  @map("time_entry_id") @db.Uuid
  /// Ответы на вопросы окна перехода (#381), JSONB-массив.
  answers       Json     @default("[]")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([entityKind, entityId, createdAt(sort: Desc)])
  @@map("transition_records")
}

/// Размещение задачи на личной доске «Мой план» (ADR-0008).
model TaskPersonalPlacement {
  taskId    String   @map("task_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  stageId   String   @map("stage_id") @db.Uuid
  sortOrder String   @map("sort_order")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  task  Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  stage WorkflowStage @relation(fields: [stageId], references: [id], onDelete: Restrict)

  @@id([taskId, userId])
  @@index([userId, stageId, sortOrder, taskId])
  @@map("task_personal_placements")
}

model TaskChecklistItem {
  id        String    @id @default(uuid()) @db.Uuid
  taskId    String    @map("task_id") @db.Uuid
  text      String
  done      Boolean   @default(false)
  sortOrder String    @map("sort_order")
  doneBy    String?   @map("done_by") @db.Uuid
  doneAt    DateTime? @map("done_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, sortOrder])
  @@map("task_checklist_items")
}

/// Связь задач (relates | blocks | precedes | duplicates).
model TaskRelation {
  id         String   @id @default(uuid()) @db.Uuid
  fromTaskId String   @map("from_task_id") @db.Uuid
  toTaskId   String   @map("to_task_id") @db.Uuid
  kind       String
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  fromTask Task @relation("RelationFrom", fields: [fromTaskId], references: [id], onDelete: Cascade)
  toTask   Task @relation("RelationTo", fields: [toTaskId], references: [id], onDelete: Cascade)

  @@unique([fromTaskId, toTaskId, kind])
  @@index([toTaskId])
  @@map("task_relations")
}

/// Трудозатраты (I14). taskId и projectId необязательны (задел «раскида
/// дня» без миграций). Идущий таймер — method=timer, ended_at NULL; один на
/// сотрудника — частичный unique в миграции.
model TimeEntry {
  id        String    @id @default(uuid()) @db.Uuid
  taskId    String?   @map("task_id") @db.Uuid
  projectId String?   @map("project_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  minutes   Int       @default(0)
  /// День работы сотрудника (не момент).
  date      DateTime  @db.Date
  /// manual | timer.
  method    String
  startedAt DateTime? @map("started_at") @db.Timestamptz()
  endedAt   DateTime? @map("ended_at") @db.Timestamptz()
  comment   String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  task Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt(sort: Desc), id])
  @@index([userId, date])
  /// Трудозатраты по проекту (отчёт ступени 3 M4, I14).
  @@index([projectId, date])
  @@map("time_entries")
}

/// Ревизии результата задачи (append-only; текущий — последний).
model TaskResult {
  id         String   @id @default(uuid()) @db.Uuid
  taskId     String   @map("task_id") @db.Uuid
  text       String
  messageIds Json     @default("[]") @map("message_ids")
  authorId   String   @map("author_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt(sort: Desc)])
  @@map("task_results")
}

// ===== Модуль dictionaries (issue #54, ядро; I15) =====
// Бизнес-списки — данные, не код: справочник адресуется стабильным `code`,
// элемент — по UUID (ссылающиеся модули хранят plain UUID без FK, I3).
// Удаления нет — архивация is_active; поэтому FK — Restrict.

/// Справочник: системные (is_system) создаёт миграция — их ждёт код-потребитель.
model Dictionary {
  id           String  @id @default(uuid()) @db.Uuid
  code         String  @unique
  name         String
  hierarchical Boolean @default(false)
  isSystem     Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  items DictionaryItem[]

  @@map("dictionaries")
}

/// Элемент справочника; parent_id — только у иерархических справочников.
model DictionaryItem {
  id           String  @id @default(uuid()) @db.Uuid
  dictionaryId String  @map("dictionary_id") @db.Uuid
  parentId     String? @map("parent_id") @db.Uuid
  /// Необязательный машинный ключ (системные элементы сида) — уникален в справочнике.
  code         String?
  name         String
  sortOrder    Int     @default(0) @map("sort_order")
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  dictionary Dictionary       @relation(fields: [dictionaryId], references: [id], onDelete: Restrict)
  parent     DictionaryItem?  @relation("DictionaryItemTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   DictionaryItem[] @relation("DictionaryItemTree")

  @@unique([dictionaryId, code])
  /// Список элементов справочника в порядке выдачи (keyset sort_order, name, id) + FK.
  @@index([dictionaryId, sortOrder, name, id])
  @@index([parentId])
  @@map("dictionary_items")
}

// ===== Модуль crm (#460, ADR-0033) =====
// Master-данные внешних организаций: контрагенты и контактные лица.
// Потребители ссылаются по id (plain UUID, I3): корреспондент и подписант
// письма (#55), заказчик проекта (#52). Удаления нет — архивация.

/// Контрагент. УНП нормализован контрактом (`unpInputSchema`) и уникален
/// среди ВСЕХ записей, включая архив (NULL-ы в PostgreSQL различны →
/// «уникален, если указан»; архив держит УНП → «вернуть из архива», не дубль).
model Counterparty {
  id           String    @id @default(uuid()) @db.Uuid
  shortName    String    @map("short_name")
  fullName     String    @map("full_name")
  unp          String?   @unique
  address      String?
  email        String?
  phone        String?
  /// Кастомные поля области `counterparty` (ADR-0029); запись — с #431.
  customFields Json      @default("{}") @map("custom_fields")
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz()
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  contacts ContactPerson[]
  usages   CounterpartyUsage[]

  /// Реестр: keyset по (short_name, id).
  @@index([shortName, id])
  /// Подсказка похожих (pg_trgm): нечёткое сходство названий.
  @@index([shortName(ops: raw("gin_trgm_ops"))], type: Gin, map: "counterparties_short_name_trgm")
  @@index([fullName(ops: raw("gin_trgm_ops"))], type: Gin, map: "counterparties_full_name_trgm")
  /// Кастомные поля (#431): поиск по ключам JSONB.
  @@index([customFields(ops: JsonbPathOps)], type: Gin, map: "counterparties_custom_fields_gin")
  @@map("counterparties")
}

/// Контактное лицо контрагента (подписант письма — #55, адреса — #464).
model ContactPerson {
  id             String    @id @default(uuid()) @db.Uuid
  counterpartyId String    @map("counterparty_id") @db.Uuid
  fullName       String    @map("full_name")
  position       String?
  email          String?
  phone          String?
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  counterparty Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Restrict)

  @@index([counterpartyId, fullName, id])
  /// Подстановка контрагента по адресу отправителя письма (#56, Р6).
  @@index([email])
  @@map("contact_persons")
}

/// Проекция «кто ссылается на контрагента» — источник lettersCount/projectsCount
/// (ADR-0033 п.3). Пишут обработчики событий писем (#55) и проектов (#52);
/// в #460 таблица пуста. PK (source_kind, source_id): у письма один
/// корреспондент, у проекта один заказчик — повторная доставка события
/// безвредна (upsert/delete).
model CounterpartyUsage {
  /// letter | project — системная константа (zod в обработчике).
  sourceKind String @map("source_kind")
  /// id письма/проекта — plain UUID без FK (чужой модуль, I3).
  sourceId   String @map("source_id") @db.Uuid

  counterpartyId String   @map("counterparty_id") @db.Uuid
  /// Подписант письма (ContactPerson, #55): «в этом письме подписал X».
  /// null у проектов и у письма без подписанта.
  contactId      String?  @map("contact_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  counterparty Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Restrict)

  @@id([sourceKind, sourceId])
  @@index([counterpartyId, sourceKind])
  @@index([contactId])
  @@map("counterparty_usages")
}

// ===== Модуль projects (#52, ADR-0030) =====
// Проект = договор («тема» — без шифра): тип, портфель, заказчик (контрагент
// crm — plain UUID без FK, I3), руководство (руководитель + помощники) и
// двухрежимное участие (открытый — динамика из задач, секретный — ручной
// состав). Удаления нет — архив статусом; шифр не освобождается архивацией
// (частичный unique — Trimble-паттерн «number previously used»).

/// Тип проекта — справочник раздела «Автоматизация» (сид-миграция: «Договор»,
/// «Тема»); шаблоны уровней дерева и схемы — следующие issues (ADR-0030).
model ProjectType {
  id         String    @id @default(uuid()) @db.Uuid
  name       String    @unique
  /// Политика системного поля «Шифр» в форме проекта этого типа
  /// (hidden | optional | required, CHECK в миграции): «Договор» — шифр
  /// обязателен, «Тема» — поля нет. Мост к формам типов «Автоматизации»
  /// (#38/#468): полный набор полей типа придёт схемой формы.
  codeField  String    @default("optional") @map("code_field")
  /// Значок и цвет плитки типа (#556, вердикт 02.11) — ключи закрытых
  /// реестров contracts (processTypeIconSchema, projectColorSchema).
  icon       String    @default("file-text")
  color      String    @default("blue")
  /// Допустимые виды папок типа (#556): null — все виды справочника,
  /// массив — только перечисленные (id строк node_kinds, ≤50 — контракт).
  /// Снятый с типа вид живёт у уже созданных папок; создание/смена вида
  /// вне списка — 422 PROJECT_NODE_KIND_NOT_ALLOWED.
  kindIds    Json?     @map("kind_ids")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz()
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  projects Project[]

  @@map("project_types")
}

/// Портфель — плоский список группировки проектов (один заказчик — один
/// большой объект, ADR-0030 п.2); состав заказчиков выводится из проектов.
model ProjectGroup {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  /// Создатель портфеля — plain UUID без FK (справочник directory, I3).
  creatorId  String    @map("creator_id") @db.Uuid
  archivedAt DateTime? @map("archived_at") @db.Timestamptz()
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  projects Project[]

  /// Реестр: keyset по (name, id).
  @@index([name, id])
  @@map("project_groups")
}


/// Проект. Руководитель/создатель/заказчик — plain UUID без FK (модули
/// directory/crm, I3); помощники — массив UUID в JSONB (паттерн
/// mentionedUserIds; лимит ≤10 — контракт и CHECK в миграции).
model Project {
  id          String    @id @default(uuid()) @db.Uuid
  /// Шифр договора; null — «тема». Частичный unique WHERE code IS NOT NULL —
  /// в миграции (шифр не освобождается архивацией).
  code        String?
  name        String
  description String    @default("")
  /// Тон плитки-идентичности (projectColorSchema: ключи, не hex, I15).
  color       String    @default("blue")
  typeId      String    @map("type_id") @db.Uuid
  portfolioId String?   @map("portfolio_id") @db.Uuid
  clientId    String?   @map("client_id") @db.Uuid
  managerId   String    @map("manager_id") @db.Uuid
  assistantIds Json     @default("[]") @map("assistant_ids")
  /// open | secret (CHECK в миграции): секретный видят только участники
  /// (+ project.view_secret — системный надзор).
  visibility  String    @default("open")
  /// active | completed | archived (CHECK в миграции): completed — метка,
  /// archived — заморозка (создание задач в проекте — 422).
  status      String    @default("active")
  completedAt DateTime? @map("completed_at") @db.Timestamptz()
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz()
  startedAt   DateTime? @map("started_at") @db.Date
  endsAt      DateTime? @map("ends_at") @db.Date
  /// Кастомные атрибуты области `project` (ADR-0029); GIN — в миграции.
  customFields Json     @default("{}") @map("custom_fields")
  creatorId   String    @map("creator_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  type        ProjectType        @relation(fields: [typeId], references: [id], onDelete: Restrict)
  portfolio   ProjectGroup?      @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
  participants ProjectParticipant[]
  nodes       ProjectNode[]

  /// Журнал: keyset по (updated_at DESC, id) — активность = updatedAt.
  @@index([status, updatedAt(sort: Desc), id])
  /// Видимый срез для видимости задач: открытые проекты одним индексом.
  @@index([visibility, id])
  @@index([typeId])
  @@index([portfolioId])
  /// Вкладка «Проекты» карточки контрагента (#460).
  @@index([clientId])
  /// «Руковожу»: проекты руководителя.
  @@index([managerId])
  @@index([assistantIds(ops: JsonbPathOps)], type: Gin, map: "projects_assistants_gin")
  @@index([customFields(ops: JsonbPathOps)], type: Gin, map: "projects_custom_fields_gin")
  @@map("projects")
}

/// Проекция участия (Р2 техплана #52): строка на (проект, сотрудник,
/// источник). manager/assistant — из полей проекта; task — динамика живых
/// задач открытых проектов (события task.*, истина — порт
/// TASK_PROJECT_READER; наблюдатели задач НЕ попадают — вердикт 29.10);
/// member/observer — ручное управление составом секретного; observer
/// (joined) — «Присоединиться» в открытом. У одного сотрудника в проекте
/// может быть несколько источников.
model ProjectParticipant {
  projectId    String   @map("project_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  /// manager | assistant | task | member | observer (CHECK в миграции).
  source       String
  /// invited | creator | joined — только у source=observer (CHECK).
  observerKind String?  @map("observer_kind")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// «Мои проекты» и roster канала.
  @@id([projectId, userId, source])
  @@index([userId])
  @@map("project_participants")
}

/// Вид папки структуры (#467, #556): настраиваемый тип папки — ярлык
/// (значок + цвет) и конфигурация (форма создания + возможности).
/// Справочник «Автоматизации»; удаление = архивация (папки архивного вида
/// создавать нельзя, существующие живут). Уникальность имени без учёта
/// регистра и краёв — lower(btrim(name)) индексом в миграции (Prisma это
/// не выражает). Посев 6 видов — миграцией (ТКП 45-1.02-295).
model NodeKind {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  /// Ключ закрытого реестра contracts (nodeKindIconSchema, I15).
  icon       String
  /// Тон ярлыка (projectColorSchema).
  color      String
  /// Конфигурация вида (#556, Р2): {form:{code, fields:[{fieldId,state}]},
  /// capabilities:[…]}. Закрытая zod-схема, толерантное чтение
  /// (normalizeNodeKindConfig); `{}` — умолчания. Форма вида И ЕСТЬ привязка
  /// атрибутов области `node` (Р3) — отдельной таблицы нет.
  config     Json      @default("{}")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz()
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  nodes ProjectNode[]

  @@map("node_kinds")
}

/// Узел структуры проекта (#467): папка-агрегат со свободной вложенностью
/// («папки в проводнике, задачи — файлы»); задачи — листья через
/// tasks.node_id (plain UUID, модуль задач). Порядок среди детей родителя —
/// fractional-ключ `order` TEXT COLLATE "C" (канон 20261016180000). Узлы
/// БЕЗ архивации: пустой удаляется, непустой — 409. Лимиты (контракты
/// NODE_LIMITS): ≤1000 узлов на проект, глубина ≤10, детей ≤100. Шифр узла
/// уникален в проекте — частичный unique WHERE code IS NOT NULL в миграции.
model ProjectNode {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  kindId   String   @map("kind_id") @db.Uuid
  name      String
  code      String?
  order     String
  /// Кастомные атрибуты области `node` (#556, ADR-0029): значения по id
  /// определения. Хранятся ВСЕ значения, включая скрытые сменой вида; форма
  /// фильтрует помощником nodeFormValues. GIN — в миграции.
  customFields Json  @default("{}") @map("custom_fields")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  project  Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   ProjectNode? @relation("NodeTree", fields: [parentId], references: [id], onDelete: Restrict)
  children ProjectNode[] @relation("NodeTree")
  kind     NodeKind    @relation(fields: [kindId], references: [id], onDelete: Restrict)

  @@index([projectId, parentId])
  @@index([projectId, order])
  @@index([customFields(ops: JsonbPathOps)], type: Gin, map: "project_nodes_custom_fields_gin")
  @@map("project_nodes")
}

/// Настройки портала (окно «Настройки портала», #52 Р7): ключ — точечная
/// нотация (`projects.defaultVisibility`), значение — JSONB; дефолт кода —
/// 'open' при отсутствии строки.
model PortalSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("portal_settings")
}

// ===== Модуль custom-fields (#431, ADR-0029) =====
// Реестр определений атрибутов: область, тип, настройки типа, умолчание,
// видимость. Значения НЕ здесь: они живут в JSONB сущности-владельца
// (tasks.custom_fields, …) по id определения — переименование безопасно,
// «code» у атрибута нет (О10). Скрытие (hidden) заменяет архив (вердикт
// владельца 25.10.2026): значения живут и доступны процессам/отчётам, но
// карточки, фильтры и окна переходов атрибут не видят.

/// Определение кастомного атрибута. Удаление — физическое, вместе со
/// значениями (стираются владельцем при следующем чтении: ключа нет в
/// реестре), поэтому отдельной таблицы значений нет.
model FieldDefinition {
  id            String  @id @default(uuid()) @db.Uuid
  /// task | letter | project | counterparty — домен в CHECK миграции.
  scope         String
  /// Тип из `customFieldTypeSchema` (16 значений) — домен в CHECK миграции.
  type          String
  name          String
  hint          String?
  /// Настройки типа: precision (число), currencyId (деньги), dictionaryId (список).
  settings      Json    @default("{}")
  /// Умолчание: {kind:'static', value} | {kind:'author_department'}.
  defaultValue  Json?   @map("default_value")
  /// Флаг «индексировать для отчётов» (Р9): материализация — по триггеру (Н4).
  reportIndexed Boolean @default(false) @map("report_indexed")
  /// Скрытый (служебный) атрибут: не виден никому в карточках, фильтрах и
  /// окнах переходов; процессы, автоматика и отчёты значения видят.
  hidden        Boolean @default(false)
  sortOrder     Int     @default(0) @map("sort_order")
  /// Автор определения — plain UUID без FK (пользователь живёт в auth, I3).
  createdById   String? @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  typeBindings FieldDefinitionType[]

  /// Выдача реестра области в порядке карточки: (scope, sort_order, id).
  @@index([scope, sortOrder, id])
  @@map("field_definitions")
}

/// Привязка атрибута к типу процесса (#432, Р8): атрибут виден и принимает
/// значения только у своих типов; заполненное при снятии привязки не
/// стирается. Каскад — определение удаляется целиком, тип не удаляется
/// (архив), но каскад страхует от сирот. Обратный индекс — по типу: список
/// «атрибуты типа» читается на каждой карточке и форме.
model FieldDefinitionType {
  definitionId  String   @map("definition_id") @db.Uuid
  processTypeId String   @map("process_type_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  definition  FieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  processType ProcessType     @relation(fields: [processTypeId], references: [id], onDelete: Cascade)

  @@id([definitionId, processTypeId])
  @@index([processTypeId])
  @@map("field_definition_types")
}

// ===== Модуль корреспонденции (#55, ADR-0027) =====
// Письмо — сущность на движке «Процессы»: тип/маршрут/стадия — plain UUID без
// FK (I3, как задачи). Регистрационный номер выдаёт движок (assign_number),
// письмо хранит его денормализацией ради реестров и уникальности.

/// Письмо: «Новое» (не зарегистрировано) → регистрация → маршрут.
/// Удаление — физическое (спам, только из «Новое»); история — event log.
model Letter {
  id             String   @id @default(uuid()) @db.Uuid
  typeId         String   @map("type_id") @db.Uuid
  workflowId     String   @map("workflow_id") @db.Uuid
  stageId        String   @map("stage_id") @db.Uuid
  /// Денормализация stage.systemState в той же tx (фильтры, I14).
  systemState    String   @map("system_state")
  stateChangedAt DateTime @default(now()) @map("state_changed_at") @db.Timestamptz()
  /// incoming | outgoing (совпадает с ProcessType.direction; CHECK в миграции).
  direction      String

  /// Регистрационный номер «Вх-2026/118»: выдаётся один раз, неизменяем.
  /// Поля reg_* заполняются вместе (CHECK в миграции).
  regNumber    String?   @map("reg_number")
  regSeriesId  String?   @map("reg_series_id") @db.Uuid
  regYear      Int?      @map("reg_year")
  regSeq       Int?      @map("reg_seq")
  /// Дата регистрации (день Минска) — печатается в карточке.
  regDate      DateTime? @map("reg_date") @db.Date
  registeredAt DateTime? @map("registered_at") @db.Timestamptz()
  registrarId  String?   @map("registrar_id") @db.Uuid

  subject          String?
  theirNumber      String?   @map("their_number")
  theirDate        DateTime? @map("their_date") @db.Date
  counterpartyId   String?   @map("counterparty_id") @db.Uuid
  signerId         String?   @map("signer_id") @db.Uuid
  receiptMethodId  String?   @map("receipt_method_id") @db.Uuid
  projectId        String?   @map("project_id") @db.Uuid
  addresseeId      String?   @map("addressee_id") @db.Uuid
  responseDeadline DateTime? @map("response_deadline") @db.Date
  /// Кастомные поля (FieldDefinition области `letter`); GIN — в миграции.
  customFields     Json      @default("{}") @map("custom_fields")

  /// manual (создано в портале) | mail (#56, CHECK в миграции).
  source     String   @default("manual")
  createdBy  String   @map("created_by") @db.Uuid
  /// Момент поступления — ось очереди «Новые» (у ручного = создания).
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz()
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // ===== Почтовый конверт (#56, ADR-0035; null у ручных писем по смыслу
  // полей: адрес/Message-ID пусты, флаги не горят). =====
  /// Message-ID конверта: дедуп повторной доставки и ключ цепочки «ответ
  /// на»; частичный unique — в миграции. null — письмо без него.
  mailMessageId String? @map("mail_message_id")
  /// In-Reply-To конверта (один ID; диагностика цепочки).
  mailInReplyTo String? @map("mail_in_reply_to")
  /// References конверта — список ID предков (кап 100 на приёме).
  mailReferences Json?   @map("mail_references")
  mailFromAddress String? @map("mail_from_address")
  mailFromName    String? @map("mail_from_name")
  /// Письмо не разобрано целиком — реквизиты и файлы неполные (анти-яд).
  mailParseIssue        Boolean @default(false) @map("mail_parse_issue")
  /// Часть письма не сохранена (исходник/вложения сверх лимита) — Р12.
  mailStorageIncomplete Boolean @default(false) @map("mail_storage_incomplete")
  /// PDF-копия тела не создана (конвертер отказал после ретраев — «Основной
  /// документ письма» #56): кандидат «текст-PDF» недоступен, письмо живёт.
  mailBodyPdfIssue      Boolean @default(false) @map("mail_body_pdf_issue")
  /// Надгробие спама (Р13): файлы снесены, строка живёт ради Message-ID —
  /// переимпорт удалённого не возвращает его в «Новые». Списки/GET фильтруют.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  /// «Конфиденциально» (#461, Р4, В3): письмо, его чат, файлы и созданные из
  /// него поручения видят ТОЛЬКО участники (регистратор, адресат, участники
  /// обсуждения) и держатели `correspondence.view_confidential` — ни списки,
  /// ни поиск, ни ссылка чужому не отдают письмо (404 без оракула). По
  /// умолчанию флаг никому не выдаётся, даже администратору.
  confidential Boolean @default(false)

  attachments  LetterAttachment[]
  attachedRefs LetterAttachedRef[]
  participants LetterParticipant[]
  views        LetterView[]
  relations    LetterRelation[] @relation("LetterRelationsFrom")
  replyToLink  LetterRelation[] @relation("LetterRelationsTo")

  @@unique([regSeriesId, regYear, regSeq])
  /// Очередь «Новые» и реестр зарегистрированных (keyset, id — tiebreak).
  @@index([receivedAt(sort: Desc), id])
  @@index([registeredAt(sort: Desc), id])
  @@index([counterpartyId, registeredAt(sort: Desc), id])
  @@index([addresseeId, systemState])
  @@index([stageId])
  @@index([typeId])
  @@index([customFields(ops: JsonbPathOps)], type: Gin, map: "letters_custom_fields_gin")
  @@map("letters")
}

/// Файл письма. Роль: main — основной документ («Письмо» во вьювере), body —
/// HTML/текст тела, body_pdf — PDF-копия тела («Основной документ письма»
/// #56: системный кандидат, роль неизменна — главным становится де-факто,
/// пока main не выбран), attachment — приложение, source — исходник почты
/// (#56). Частичные unique «один main, один body и один body_pdf на письмо»
/// — в миграции.
model LetterAttachment {
  id        String   @id @default(uuid()) @db.Uuid
  letterId  String   @map("letter_id") @db.Uuid
  /// Файл модуля files — plain UUID без FK (I3).
  fileId    String   @map("file_id") @db.Uuid
  /// main | body | body_pdf | attachment | source (CHECK в миграции).
  role      String
  sortOrder Int      @default(0) @map("sort_order")
  /// Content-ID MIME-части (#56): связывает inline-картинку HTML-тела с
  /// вложением (cid: резолв на показе); null — обычное вложение.
  contentId String? @map("content_id")
  /// Inline-часть (картинка в HTML-теле): из блока «Файлы» скрыта.
  inline    Boolean @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  letter Letter @relation(fields: [letterId], references: [id], onDelete: Cascade)

  @@index([letterId, sortOrder])
  @@index([fileId])
  @@map("letter_attachments")
}

/// Участник обсуждения письма («Присоединиться к обсуждению»). Состав чата —
/// адресат + участники; регистратор в чат не входит (В2).
model LetterParticipant {
  letterId  String   @map("letter_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// participant (в #55 единственная роль; задел #461/#463).
  role      String   @default("participant")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  letter Letter @relation(fields: [letterId], references: [id], onDelete: Cascade)

  @@id([letterId, userId])
  @@index([userId])
  @@map("letter_participants")
}

/// Личный признак «просмотрено» (редизайн #56): строка на сотрудника —
/// индикатор «я ещё не открывал» гаснет при открытии карточки. Общего
/// счётчика «никто не смотрел» нет (решение владельца 28.10).
model LetterView {
  letterId  String   @map("letter_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  viewedAt  DateTime @default(now()) @map("viewed_at") @db.Timestamptz()

  letter Letter @relation(fields: [letterId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([letterId, userId])
  @@index([userId])
  @@map("letter_views")
}

/// Связь письма с письмом (#56, Р5; UI связей — #461): сейчас единственный
/// вид — «ответ на» (kind='reply_to'), не больше одного на письмо (частичный
/// unique в миграции); source: auto — почтовая цепочка, manual — галочка Вики.
model LetterRelation {
  id              String   @id @default(uuid()) @db.Uuid
  letterId        String   @map("letter_id") @db.Uuid
  relatedLetterId String   @map("related_letter_id") @db.Uuid
  /// reply_to — «ответ на» (авто по почтовой цепочке или ручная связь);
  /// nested_in — «вложено в» (матрёшка: письмо лежит в конверте другого).
  /// CHECK списка и запрет самосвязи — в миграции; частичные unique «один
  /// reply_to» и «один nested_in» — там же (#461, Р1).
  kind            String
  /// auto | manual (CHECK в миграции).
  source          String
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  letter        Letter @relation("LetterRelationsFrom", fields: [letterId], references: [id], onDelete: Cascade)
  relatedLetter Letter @relation("LetterRelationsTo", fields: [relatedLetterId], references: [id], onDelete: Cascade)

  @@index([letterId])
  @@index([relatedLetterId])
  @@map("letter_relations")
}

/// Строка «приложенных писем» (#461, Р3): конверт-матрёшка — письмо
/// пришло пачкой вложенных документов («№ 456, Беларуськалий, 18.10.2026»).
/// Организация — ВСЕГДА контрагент справочника (вердикт владельца 05.11.2026:
/// свободного текста нет — нет организации вне CRM, лишних «одноразовых»
/// строк и расхождений с карточкой); нет нужного контрагента — его заводят
/// из окна строки. `counterparty_id` — plain UUID без FK (I3: CRM — чужой
/// модуль, как `letters.counterparty_id`). Вложения-файлы сюда не входят —
/// это реестр вложенных ДОКУМЕНТОВ.
model LetterAttachedRef {
  id             String    @id @default(uuid()) @db.Uuid
  letterId       String    @map("letter_id") @db.Uuid
  /// № приложенного письма — ключ поиска по реестрам (кап 64).
  number         String
  counterpartyId String    @map("counterparty_id") @db.Uuid
  letterDate     DateTime? @map("letter_date") @db.Date
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  letter Letter @relation(fields: [letterId], references: [id], onDelete: Cascade)

  @@index([letterId, sortOrder])
  /// Поиск «найди письмо с приложенным № 456» (Р8): подстрока по номеру.
  @@index([number])
  @@map("letter_attached_refs")
}

/// Ящик-источник почты (#56, ADR-0035; ADR-0027 «ящики, курсор
/// UIDVALIDITY/UID»): курсор и аккумуляторы цикла приёма. Один ящик до #477
/// (код 'chancery' сидируется миграцией); personal — там же.
model MailSource {
  id        String   @id @default(uuid()) @db.Uuid
  /// Системный код ящика ('chancery') — адресует события sync_failed.
  code      String   @unique
  /// UIDVALIDITY INBOX: смена — полный переобход под дедупом Message-ID.
  uidValidity BigInt? @map("uid_validity")
  /// Курсор: обработаны UID ≤ lastUid; null/0 при первом запуске = max UID.
  lastUid      BigInt? @map("last_uid")
  /// Аккумулятор порога (Р4): ≥3 неудачных циклов подряд — уведомление.
  consecutiveFailures Int      @default(0) @map("consecutive_failures")
  /// Троттлинг уведомления о молчании ящика: раз в 24 ч.
  lastNotifiedAt DateTime? @map("last_notified_at") @db.Timestamptz()
  lastError      String?   @map("last_error")
  lastSyncAt     DateTime? @map("last_sync_at") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("mail_sources")
}
