{
  "name": "nodus",
  "version": "0.0.0",
  "private": true,
  "license": "Elastic-2.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "node --env-file=.env ./node_modules/turbo/bin/turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test --filter=!@nodus/e2e",
    "test:coverage": "turbo test:coverage --filter=!@nodus/e2e",
    "test:e2e": "pnpm --filter @nodus/e2e test",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "diff-coverage": "node scripts/diff-coverage.mjs --base origin/main --threshold 80",
    "lint": "eslint . --max-warnings 39",
    "live-stack": "node scripts/live-stack.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node scripts/install-hooks.mjs",
    "plan:check": "node scripts/check-plan.mjs",
    "incubator:check": "node scripts/check-incubator.mjs"
  },
  "devDependencies": {
    "@nodus/config": "workspace:*",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^10.14.0",
    "lefthook": "^2.2.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3"
  }
}
