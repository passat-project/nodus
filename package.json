{
  "name": "nodus",
  "version": "0.0.0",
  "private": true,
  "license": "Elastic-2.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "node --env-file=.env ./node_modules/turbo/bin/turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test --filter=!@nodus/e2e",
    "test:coverage": "turbo test:coverage --filter=!@nodus/e2e",
    "test:e2e": "pnpm --filter @nodus/e2e test",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "assistant:smoke": "node scripts/assistant-smoke.mjs",
    "assistant:eval": "pnpm --filter @nodus/api exec vitest run src/modules/assistant/eval/eval-gate.test.ts --reporter=verbose",
    "assistant:catalog": "pnpm --filter @nodus/api exec vitest run src/modules/assistant/tools/tool-standard.test.ts src/modules/assistant/tools/catalog.test.ts",
    "assistant:surface": "node scripts/assistant-docs.mjs surface",
    "assistant:standard": "node scripts/assistant-docs.mjs standard",
    "diff-coverage": "node scripts/diff-coverage.mjs --base origin/main --threshold 80",
    "lint": "eslint . --max-warnings 39",
    "live-stack": "node scripts/live-stack.mjs",
    "search:reindex": "node apps/api/dist/modules/search/cli/reindex.js",
    "search:perf": "node apps/api/dist/modules/search/perf/measure.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node scripts/install-hooks.mjs",
    "plan:check": "node scripts/check-plan.mjs",
    "incubator:check": "node scripts/check-incubator.mjs"
  },
  "devDependencies": {
    "@nodus/config": "workspace:*",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "^10.15.0",
    "lefthook": "^2.2.2",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "~5.9.3"
  }
}
